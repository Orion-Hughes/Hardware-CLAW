    "dependencies": [],
    "headers": [
      "Arduino.h"
    ],
    "initialization": [
      "analogReadResolution(12);",
      "analogSetPinAttenuation(PIN_VERT, ADC_11db);",
      "analogSetPinAttenuation(PIN_HORZ, ADC_11db);",
      "pinMode(PIN_SEL, INPUT_PULLUP);"
    ],
    "operations": [
      "int vertical = analogRead(PIN_VERT); int horizontal = analogRead(PIN_HORZ);",
      "bool pressed = digitalRead(PIN_SEL) == LOW;",
      "输出范围0..4095；中心阈值需校准，使用死区与按键消抖。"
    ],
